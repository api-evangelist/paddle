{
  "opencollection": "1.0.0",
  "info": {
    "name": "Paddle Addresses Reports API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Reports",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List reports",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.paddle.com/reports"
          },
          "docs": "List reports"
        },
        {
          "info": {
            "name": "Create a report",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.paddle.com/reports",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a report"
        },
        {
          "info": {
            "name": "Get a report",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.paddle.com/reports/:report_id",
            "params": [
              {
                "name": "report_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a report"
        },
        {
          "info": {
            "name": "Get a CSV file for a report",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.paddle.com/reports/:report_id/csv",
            "params": [
              {
                "name": "report_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a CSV file for a report"
        }
      ]
    }
  ],
  "bundled": true
}